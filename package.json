{
  "name": "@zowe/cics_monorepo",
  "private": true,
  "version": "6.23.2",
  "packageManager": "pnpm@10.5.2",
  "publishConfig": {
    "registry": "https://zowe.jfrog.io/zowe/api/npm/npm-local-release/"
  },
  "repository": "https://github.com/zowe/cics-for-zowe-client",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r --stream --sort run build",
    "watch": "pnpm -r --parallel run watch",
    "package": "pnpm run build && pnpm -r --sort run package",
    "test": "pnpm -r run test",
    "test:system": "pnpm run validate:system-tests && pnpm -r run test:system",
    "test:unit": "pnpm -r run test:unit",
    "test:e2e": "pnpm --filter cics-extension-for-zowe run test:e2e",
    "lint": "eslint --ignore-pattern packages --ignore-pattern scripts && pnpm -r run lint",
    "lintErrors": "pnpm -r run lintErrors",
    "prepare": "husky install",
    "license": "node scripts/updateLicenses.js",
    "pretty": "prettier --write .",
    "validate:system-tests": "node scripts/validate-system-test-config.js",
    "clean": "pnpm -r run clean && rimraf dist/*.tgz dist/*.vsix"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@types/glob": "^8.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.15.34",
    "@types/uuid": "^9.0.1",
    "@types/xml2js": "^0.4.4",
    "@types/yargs": "^17.0.24",
    "@zowe/cli-test-utils": "^8.41.1",
    "@zowe/imperative": "^8.43.0",
    "@zowe/zowe-explorer-api": "^3.6.0",
    "chalk": "^4.1.2",
    "diff": "^8.0.3",
    "eslint": "^10.0.1",
    "glob": "^13.0.6",
    "globals": "^17.3.0",
    "husky": "^8.0.3",
    "jest": "^30.2.0",
    "jest-environment-node": "^29.5.0",
    "jest-environment-node-debug": "^2.0.0",
    "jest-junit": "^17.0.0",
    "jest-mock-vscode": "^4.0.4",
    "madge": "^6.0.0",
    "minimatch": "^10.2.2",
    "npm-packlist": "^9.0.0",
    "prettier": "^3.5.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rimraf": "^6.1.3",
    "supports-color": "^7.2.0",
    "terser": "^5.16.8",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.4.0",
    "typedoc": "^0.28.17",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.0",
    "uuid": "^14.0.0"
  }
}
